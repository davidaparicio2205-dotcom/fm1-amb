# a first look and listen: it grows from power-on; the pages; a minute of the garden
wav first.wav
wait 200
expect playing 1
# the first piece, Monochrome: A Aeolian
expect pool 0x5AD
expect par19 9
expect era 0
wait 6000
shot garden.png
expect pad_level >40
wait 30000
shot garden30.png
expect sixteenths >40
expect loopnotes >0
wavstop
expect peak_db_max -0.5
expect peak_db_min -30
tap ENV
wait 100
shot pad.png
tap ARP
wait 100
shot bells.png
tap LFO
wait 100
shot bass.png
tap SEQ
wait 100
shot pulse.png
tap FX
wait 100
shot space.png
tap GLO
wait 100
shot setup.png
tap SEL
wait 100
shot colour.png
expect view 7
tap GLO
# the screen keeps its pace: 30 frames a second (the eras' scenes)
wait 2000
expect fps >27
# SELECT steps through the pages, from the last back to the first
turn SELECT -6 100
expect view 0
tap HOME
